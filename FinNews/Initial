## 8. Main Loop (`main.py`)

```python
"""
Entry point. Runs the ingest → score → trigger → draft → deliver loop.

Usage:
    python main.py                  # Run continuous monitoring loop
    python main.py --once           # Run one cycle and exit (for cron)
    python main.py --digest         # Force a daily digest now
    python main.py --dashboard      # Start web dashboard only
    python main.py --backfill 24    # Backfill last 24 hours of news
"""

import time
import argparse
from config.settings import TRIGGER_IMMEDIATE, TRIGGER_BATCH
from ingest import x_ingest, news_ingest, calendar_ingest
from ingest.normalizer import normalize
from scoring.engine import score_and_trigger
from newsletter.assembler import assemble_context
from newsletter.drafter import draft_newsletter
from delivery import deliver
from scheduler import get_poll_interval, PollState, update_poll_state
from db.store import DB

def run_cycle(db: DB):
    # 1. Check velocity re-check queue first (two-pass RT measurement)
    pending_rechecks = db.get_pending_velocity_rechecks()
    if pending_rechecks:
        x_ingest.recheck_engagement(pending_rechecks, db)

    # 2. Ingest from all sources
    raw_items = []
    raw_items += x_ingest.fetch_latest()       # Syndication API → Apify → Scweet fallback
    raw_items += news_ingest.fetch_latest()     # Finnhub, Polygon, NewsAPI, EODHD
    raw_items += calendar_ingest.check_upcoming_events()

    # 3. Normalize and store
    normalized = [normalize(item) for item in raw_items]
    new_items = db.insert_many(normalized)  # Returns only genuinely new items (deduped)

    if not new_items:
        return

    # 4. Queue X tweets for velocity re-check (only those scoring > 0.3 on content)
    x_items = [i for i in new_items if i.source_type == "x_tweet"]
    for item in x_items:
        if item.content_score > 0.3:
            db.queue_velocity_recheck(item, delay_minutes=4)

    # 5. Score all new items
    scored_items = score_and_trigger(new_items, db)

    # 6. Update polling state based on scores
    update_poll_state(scored_items, db)

    # 7. Check triggers
    immediate = [i for i in scored_items if i.urgency_score >= TRIGGER_IMMEDIATE]
    batch = [i for i in scored_items if TRIGGER_BATCH <= i.urgency_score < TRIGGER_IMMEDIATE]

    # 8. Draft and deliver immediate newsletters
    if immediate and not db.is_on_cooldown(minutes=15):
        context = assemble_context(immediate, db)
        newsletter_type = classify_newsletter_type(immediate)
        draft = draft_newsletter(context, newsletter_type)
        deliver(draft, newsletter_type)
        db.log_newsletter(newsletter_type, immediate, context, draft)

    # 9. Add batch items to queue
    if batch:
        db.add_to_batch_queue(batch)

    # 10. Flush batch queue if 30 min elapsed
    if db.batch_queue_ready(interval_minutes=30):
        queued = db.flush_batch_queue()
        context = assemble_context(queued, db)
        draft = draft_newsletter(context, "breaking")
        deliver(draft, "breaking")
        db.log_newsletter("breaking", queued, context, draft)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--digest", action="store_true")
    parser.add_argument("--dashboard", action="store_true")
    parser.add_argument("--backfill", type=int, default=0)
    args = parser.parse_args()

    db = DB()
    db.initialize()

    if args.dashboard:
        from delivery.web_dashboard import run_dashboard
        run_dashboard(db)
        return

    if args.digest:
        items = db.get_top_items_today(limit=20)
        context = assemble_context(items, db)
        draft = draft_newsletter(context, "daily_digest")
        deliver(draft, "daily_digest")
        return

    if args.once:
        run_cycle(db)
        return

    # Continuous loop with adaptive polling
    print("Starting monitoring loop...")
    while True:
        try:
            run_cycle(db)
        except Exception as e:
            print(f"Cycle error: {e}")

        interval = get_poll_interval(db)  # Market-hours + state-aware interval
        time.sleep(interval)


if __name__ == "__main__":
    main()
```

