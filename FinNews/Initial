## 5. Newsletter Drafting via Claude API

### 5A. Context Assembly (`newsletter/assembler.py`)

```python
def assemble_context(triggered_items: list[NewsItem], db) -> str:
    """
    Build a token-efficient context window for the Claude API call.
    Target: < 3000 tokens of context to leave room for the draft.
    """
    sections = []

    # 1. Breaking items (what triggered this newsletter)
    sections.append("## BREAKING DEVELOPMENTS\n")
    for item in sorted(triggered_items, key=lambda x: x.urgency_score, reverse=True)[:5]:
        sections.append(format_item_for_context(item))

    # 2. Related recent items (past 2 hours, same tickers/topics, score > 0.3)
    related = db.query_related(triggered_items, hours=2, min_score=0.3)
    if related:
        sections.append("\n## RELATED CONTEXT (past 2 hours)\n")
        for item in related[:5]:
            sections.append(format_item_for_context(item))

    # 3. Calendar context (if FOMC/earnings are within 24 hours)
    calendar_ctx = get_calendar_context(db)
    if calendar_ctx:
        sections.append(f"\n## UPCOMING EVENTS\n{calendar_ctx}")

    # 4. Market snapshot
    snapshot = get_market_snapshot()  # SPY, VIX, 10Y, DXY current levels
    sections.append(f"\n## MARKET SNAPSHOT\n{snapshot}")

    return "\n".join(sections)


def format_item_for_context(item: NewsItem) -> str:
    """Compact format — every token counts."""
    ticker_str = f" [{', '.join(item.tickers)}]" if item.tickers else ""
    topic_str = f" ({', '.join(item.topics)})" if item.topics else ""
    src = f"@{item.source_name}" if item.source_type == "x_tweet" else item.source_name
    return (
        f"- [{item.published_at.strftime('%H:%M')} UTC] "
        f"{src}: {item.headline}{ticker_str}{topic_str} "
        f"[score: {item.urgency_score:.2f}]"
    )
```

### 5B. Claude API Call (`newsletter/drafter.py`)

```python
import anthropic

client = anthropic.Anthropic()  # Uses ANTHROPIC_API_KEY env var

def draft_newsletter(context: str, newsletter_type: str = "breaking") -> str:
    system_prompt = NEWSLETTER_PROMPTS[newsletter_type]

    response = client.messages.create(
        model="claude-sonnet-4-20250514",
        max_tokens=2000,
        system=system_prompt,
        messages=[
            {"role": "user", "content": context}
        ]
    )

    return response.content[0].text
```

